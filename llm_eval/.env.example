# Obtain the current port-8001 gateway URL from the lab helper on BigPurple.
# Do not hardcode a compute-node hostname in source code.
OPENAI_BASE_URL=http://current-head-node:8001/v1

# Barney uses this value as the caller identity shown on the lab dashboard.
OPENAI_API_KEY=your_nyu_netid

# Claude API authentication. Keep the real key only in an ignored .env file.
ANTHROPIC_API_KEY=your_anthropic_api_key
