# Postgres connection string (set ONE of these)
DATABASE_URL=
# POSTGRES_URL=

# Optional: require an access code on landing page + API
EVAL_ACCESS_CODE=

# Optional: default number of model responses to claim per rater (UI + API)
# NOTE: NEXT_PUBLIC_* vars are embedded into the client bundle at build time.
NEXT_PUBLIC_DEFAULT_ASSIGNMENT_COUNT=150

# Optional (recommended): protect /admin + /api/admin/* with HTTP Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=
