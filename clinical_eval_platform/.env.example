# Postgres connection string (required outside local demo mode)
DATABASE_URL=
# POSTGRES_URL=

# Required in production: gates annotator sessions and every query/annotation API
EVAL_ACCESS_CODE=

# Required in production: protects /admin and /api/admin/* with HTTP Basic Auth
ADMIN_USER=admin
ADMIN_PASSWORD=

# Production dataset: a URL in a Vercel PRIVATE Blob store.
# New Vercel connections use short-lived OIDC credentials plus BLOB_STORE_ID.
# BLOB_READ_WRITE_TOKEN remains supported for local or legacy connections.
ANNOTATION_BLOB_URL=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Local override only. Defaults to real_chats.csv, then clinical_queries.csv,
# then the source-controlled example dataset.
ANNOTATION_INPUT=
